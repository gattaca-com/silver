# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by Intellij-based IDEs.
.idea

# Generated by MacOS
.DS_Store

# VSCode
.local
.vscode
# LLMs
.cursor
.claude/*
!.claude/skills/
.memsearch

*.ssz
*.fxt*
# e2e fixtures are committed via git-lfs (see .gitattributes and
# crates/e2e/data/perf/README.md) — they need to escape the blanket
# *.ssz ignore.
!crates/e2e/data/**/*.ssz
!crates/engine/testdata/*.ssz
# kurtosis generated files
kurtosis/.cache/
kurtosis/silver-devnet.toml
kurtosis/silver-gloas.toml
kurtosis/silver-*-network/
# ethereum consensus-spec-tests
crates/beacon_state/consensus-spec-tests/
kurtosis/el/

crates/beacon_state/tile/tests/sync_scenarios/gloas_fork_transition/fixtures/

# ethereum/cryptography-specs KZG vectors, fetched by `make -C crates/crypto_simd`
crates/crypto_simd/cryptography-specs-tests/
