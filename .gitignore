# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by Intellij-based IDEs.
.idea

# Generated by MacOS
.DS_Store

# VSCode
.local
.vscode
.cursor
.claude
.local
CLAUDE.md

*.ssz
# Perf-regression fixtures are committed via git-lfs (see .gitattributes
# and crates/e2e/data/perf/README.md) — they need to escape the blanket
# *.ssz ignore.
!crates/e2e/data/perf/*.ssz
!crates/engine/testdata/*.ssz
