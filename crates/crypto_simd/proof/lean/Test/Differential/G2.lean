import Differential.Common
import LeanBlsSimd.Model.DecompressG2
import LeanBlsSimd.Extracted.Funs

/-!
# Differential tests against recorded Rust outputs

`lake exe differential ../decompress_g2_vectors.txt` runs both Lean implementations of
`decompress_g2::decompress` on every recorded batch and compares all output fields. The recording
comes from the compiled Rust kernel; `../vectors.rs` generates it and checks it against Rust.

The first implementation is the handwritten model. The second is
`silver_crypto_simd.bls.decompress_g2.decompress`, generated by Aeneas using the handwritten externals in
`LeanBlsSimd/Extracted/`. The refinement proof equates these implementations on every input.
The tests provide separate evidence that the translation and externals agree with compiled Rust
on the recorded inputs.

The exit status is 0 when every batch matches, 1 for an output mismatch or an extracted
computation returning `fail` or `div`, and 2 for invalid command-line arguments or an unreadable,
malformed, or incomplete file. Parsing requires the headers and `endfile` marker, at least one
batch, the declared batch count, sequential batch indices, and correctly formatted fields.
The first 40 mismatches per implementation are printed with their batch, kind, affected lanes,
field, and Rust and Lean values.

## File format

The file contains a header, one or more batches, and a final `endfile` line. Blank lines and
lines starting with `#` after trimming whitespace are ignored. The header is:

```
seed <seed>          the seed of the generator that chose the inputs
batches <n>          the number of batches that follow; at least 1
```

A batch is

```
batch <index> <kind>
in <192 hex digits>          eight lines, the 96 bytes of lane 0 to 7
on_curve <2 hex digits>      the three masks; bit l is lane l
valid <2 hex digits>
undecided <2 hex digits>
pt <lane> <24 hex words>     eight lines, lanes 0 to 7
end
```

Batch indices run 0 to n - 1 in file order. The 24 words of `pt` are the `u64` limbs of
`blst_p2_affine`: `x.fp[0].l`, `x.fp[1].l`, `y.fp[0].l`, `y.fp[1].l`, six limbs each, least
significant first. The writer emits words in lowercase hex without leading zeros. The `pt`
lines include coordinates from every lane, even when the lane is invalid or undecided. Those
coordinates may be all zeros or intermediate results left by the kernel.

`<kind>` names how the batch was built and is reported in mismatches.
-/

open LeanBlsSimd LeanBlsSimd.DecompressG2
open Aeneas
open Aeneas.Std (U8)

namespace DifferentialTest

/-- What `decompress` returns, as the file records it: each lane's point is 24 words. -/
structure Outputs where
  onCurve : UInt8
  valid : UInt8
  undecided : UInt8
  points : Array (Array UInt64)

structure Expected where
  index : Nat
  kind : String
  inputs : Array (Array UInt8)
  outputs : Outputs

def inputLine : Parser (Array UInt8) := do
  let (n, v) ← field "in" 192
  match hexBytes? v with
  | some b => pure b
  | none => throw s!"line {n}: bad hex in `in`"

def pointLine (lane : Nat) : Parser (Array UInt64) := do
  let (n, l) ← next
  match words l with
  | "pt" :: laneStr :: rest =>
    if laneStr ≠ toString lane || rest.length ≠ 24 then
      throw s!"line {n}: expected `pt {lane}` with 24 words"
    let ws ← rest.toArray.mapM fun w => match hexNat? w with
      | some v => if v < 2 ^ 64 then pure (UInt64.ofNat v) else throw s!"line {n}: word out of range"
      | none => throw s!"line {n}: bad hex word `{w}`"
    pure ws
  | _ => throw s!"line {n}: expected `pt {lane}` with 24 words"

def batch : Parser Expected := do
  let (n, l) ← next
  let (index, kind) ← match words l with
    | ["batch", i, k] => match i.toNat? with
      | some i => pure (i, k)
      | none => throw s!"line {n}: bad batch index"
    | _ => throw s!"line {n}: expected `batch <index> <kind>`"
  let inputs ← (Array.range 8).mapM fun _ => inputLine
  let onCurve ← maskField "on_curve"
  let valid ← maskField "valid"
  let undecided ← maskField "undecided"
  let points ← (Array.range 8).mapM pointLine
  let (n, l) ← next
  if l ≠ "end" then throw s!"line {n}: expected `end`"
  pure { index, kind, inputs, outputs := { onCurve, valid, undecided, points } }

partial def batches : Parser (Array Expected) := do
  let (_, l) ← peek
  if l = "endfile" then
    let _ ← next
    pure #[]
  else
    let b ← batch
    let rest ← batches
    pure (#[b] ++ rest)

def file : Parser (Header × Array Expected) := do
  let h ← header
  let bs ← batches
  let rest ← get
  if let some (n, _) := rest[0]? then throw s!"line {n}: text after `endfile`"
  if bs.isEmpty then throw "no batches"
  if bs.size ≠ h.count then
    throw s!"header says {h.count} batches, the file holds {bs.size}"
  for (b, i) in bs.toList.zipIdx do
    if b.index ≠ i then throw s!"batch {b.index} where batch {i} was expected"
  pure (h, bs)

def parse (text : String) : Except String (Header × Array Expected) :=
  (file.run (meaningful text)).map (·.1)

/-- The model's input type from eight 96-byte arrays. -/
def modelInputs (inputs : Array (Array UInt8)) : Vector (Vector UInt8 G2_COMPRESSED_LEN) 8 :=
  .ofFn fun l => .ofFn fun j => (inputs[l.val]!)[j.val]!

/-- The extraction's `[[u8; 96]; 8]`, holding the same bytes as the model's input. -/
def extractedInputs (inputs : Vector (Vector UInt8 G2_COMPRESSED_LEN) 8) :
    Std.Array (Std.Array U8 96#usize) 8#usize :=
  ⟨inputs.toList.map fun bytes =>
    ⟨bytes.toList.map fun b => ⟨b.toBitVec⟩, by simp [G2_COMPRESSED_LEN]⟩, by simp⟩

def fpLimbs (fp : BlstFp) : List UInt64 := fp.l.toList

/-- The 24 limbs of a point in the file's order. -/
def pointWords (p : BlstP2Affine) : Array UInt64 :=
  (fpLimbs p.x.fp[0] ++ fpLimbs p.x.fp[1] ++ fpLimbs p.y.fp[0] ++ fpLimbs p.y.fp[1]).toArray

def modelOutputs (b : Batch) : Outputs :=
  { onCurve := b.on_curve, valid := b.valid, undecided := b.undecided,
    points := b.points.toArray.map pointWords }

/-- The 12 limbs of an extracted `blst_fp2`, `fp[0]` before `fp[1]`. -/
def extractedFp2Limbs (c : silver_crypto_simd.blst.blst_fp2) : List UInt64 :=
  c.fp.val.flatMap fun fp => fp.l.val.map fun w => UInt64.ofBitVec w.bv

def extractedOutputs (b : silver_crypto_simd.bls.decompress_g2.Batch) : Outputs :=
  { onCurve := UInt8.ofBitVec b.on_curve.bv, valid := UInt8.ofBitVec b.valid.bv,
    undecided := UInt8.ofBitVec b.undecided.bv,
    points := b.points.val.toArray.map fun p =>
      (extractedFp2Limbs p.x ++ extractedFp2Limbs p.y).toArray }

/-- A Lean `decompress` under test. `run` fails when it returns no batch. -/
structure Side where
  label : String
  run : Vector (Vector UInt8 G2_COMPRESSED_LEN) 8 → Except String Outputs

def model : Side where
  label := "model"
  run inputs := .ok (modelOutputs (decompress inputs))

def extraction : Side where
  label := "extraction"
  run inputs := match silver_crypto_simd.bls.decompress_g2.decompress (extractedInputs inputs) with
    | .ok b => .ok (extractedOutputs b)
    | .fail e => .error s!"fail {repr e}"
    | .div => .error "div"

def fpName (w : Nat) : String :=
  s!"{if w / 12 = 0 then "x" else "y"}.fp[{w / 6 % 2}].l[{w % 6}]"

structure Tally where
  batches : Nat := 0
  lanes : Nat := 0
  masks : Nat := 0
  limbs : Nat := 0
  mismatches : Nat := 0

def maxPrinted : Nat := 40

def report (t : Tally) (side : Side) (e : Expected) (lane : Option Nat) (field : String)
    (rust lean : String) : IO Tally := do
  if t.mismatches < maxPrinted then
    let where_ := match lane with | some l => s!"lane {l}, " | none => ""
    IO.println s!"MISMATCH batch {e.index} ({e.kind}), {where_}{field}: Rust {rust}, \
      Lean {side.label} {lean}"
  pure { t with mismatches := t.mismatches + 1 }

def compareMask (t : Tally) (side : Side) (e : Expected) (field : String) (rust lean : UInt8) :
    IO Tally := do
  let t := { t with masks := t.masks + 1 }
  if rust = lean then pure t
  else
    let diff := (List.range 8).filter fun l => (rust ^^^ lean).toNat.testBit l
    report t side e none s!"{field} (lanes {diff})" (showMask rust) (showMask lean)

def compareBatch (t : Tally) (side : Side) (e : Expected) : IO Tally := do
  let mut t := { t with batches := t.batches + 1, lanes := t.lanes + 8 }
  let want := e.outputs
  match side.run (modelInputs e.inputs) with
  | .error msg => report t side e none "decompress" "a batch" msg
  | .ok got =>
    t ← compareMask t side e "on_curve" want.onCurve got.onCurve
    t ← compareMask t side e "valid" want.valid got.valid
    t ← compareMask t side e "undecided" want.undecided got.undecided
    for l in List.range 8 do
      let wantWords := want.points[l]!
      let gotWords := got.points[l]!
      for w in List.range 24 do
        t := { t with limbs := t.limbs + 1 }
        if wantWords[w]! ≠ gotWords[w]! then
          t ← report t side e (some l) s!"points[{l}].{fpName w}" (showHex wantWords[w]!.toNat)
            (showHex gotWords[w]!.toNat)
    pure t

def compareAll (side : Side) (expected : Array Expected) : IO Tally := do
  let start ← IO.monoMsNow
  let mut t : Tally := {}
  for e in expected do
    t ← compareBatch t side e
  let elapsed := (← IO.monoMsNow) - start
  IO.println s!"{side.label}: compared {t.batches} batches, {t.lanes} lanes, {t.masks} masks, \
    {t.limbs} point limbs in {elapsed} ms"
  pure t

def run (path : String) : IO UInt32 := do
  let read ← (IO.FS.readFile path).toBaseIO
  let .ok text := read | do
    IO.eprintln s!"{path}: cannot read"
    pure 2
  match parse text with
  | .error msg =>
    IO.eprintln s!"{path}: {msg}"
    pure 2
  | .ok (h, expected) =>
    IO.println s!"vectors: seed {h.seed}, {h.count} batches"
    let modelTally ← compareAll model expected
    let extractionTally ← compareAll extraction expected
    let mismatches := modelTally.mismatches + extractionTally.mismatches
    if mismatches = 0 then
      IO.println "all values match"
      pure 0
    else
      IO.println s!"{mismatches} mismatches"
      pure 1

end DifferentialTest
