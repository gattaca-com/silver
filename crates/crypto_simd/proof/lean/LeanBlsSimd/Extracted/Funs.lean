def bls.g2x8.G2x8.scott_membership
  (px : bls.fp2x8.Fp2x8) (py : bls.fp2x8.Fp2x8) : Result bls.Membership := do
  let (mzp, chain_undecided) ← bls.g2x8.G2x8.times_minus_z px py
  let i ← bls.fp2x8.Fp2x8.is_zero_mask mzp.z
  let undecided ← lift (chain_undecided ||| i)
  let psi_scale ← bls.fp8.Fp8.splat_limbs bls.constants.PSI_X_MONT
  let f ← bls.fp8.Fp8.mul px.c1 psi_scale
  let f1 ← bls.fp8.Fp8.mul px.c0 psi_scale
  let fx ← bls.fp2x8.Fp2x8.conjugate py
  let fx1 ← bls.fp2x8.Fp2x8.splat bls.constants.PSI_Y_MONT
  let psi_y ← bls.fp2x8.Fp2x8.mul fx fx1
  let zz ← bls.fp2x8.Fp2x8.square mzp.z
  let zzz ← bls.fp2x8.Fp2x8.mul zz mzp.z
  let fx2 ← bls.fp2x8.Fp2x8.mul { c0 := f, c1 := f1 } zz
  let x_matches ← bls.fp2x8.Fp2x8.eq_mask mzp.x fx2
  let fx3 ← bls.fp2x8.Fp2x8.neg mzp.y
  let fx4 ← bls.fp2x8.Fp2x8.mul psi_y zzz
  let y_matches ← bls.fp2x8.Fp2x8.eq_mask fx3 fx4
  let i1 ← lift (x_matches &&& y_matches)
  let i2 ← lift (~~~ undecided)
  let i3 ← lift (i1 &&& i2)
  ok { members := i3, undecided }

