def decompress_g2.decompress
  (inputs : Array (Array Std.U8 96#usize) 8#usize) :
  Result decompress_g2.Batch
  := do
  let decoded ← decompress_g2.decode inputs
  let bpa ← blst.blst_p2_affine.Insts.CoreDefaultDefault.default
  let a := Array.repeat 8#usize bpa
  let i ← lift (decoded.invalid ||| decoded.undecided)
  let decodable ← lift (~~~ i)
  if decodable = 0#u8
  then
    ok
      {
        points := a,
        on_curve := 0#u8,
        valid := 0#u8,
        undecided := decoded.undecided
      }
  else
    let f ← fp8.Fp8.from_plain decoded.x0
    let f1 ← fp8.Fp8.from_plain decoded.x1
    let four ← fp8.Fp8.splat_limbs constants.FOUR_MONT
    let fx ← fp2x8.Fp2x8.square { c0 := f, c1 := f1 }
    let fx1 ← fp2x8.Fp2x8.mul fx { c0 := f, c1 := f1 }
    let rhs ← fp2x8.Fp2x8.add fx1 { c0 := four, c1 := four }
    let (root, has_root) ← fp2x8.Fp2x8.sqrt rhs
    let i1 ← lift (has_root &&& decodable)
    if i1 = 0#u8
    then
      ok
        {
          points := a,
          on_curve := i1,
          valid := 0#u8,
          undecided := decoded.undecided
        }
    else
      let i2 ← fp2x8.Fp2x8.is_larger_root_mask root
      let flip ← lift (i2 ^^^ decoded.larger_root)
      let fx2 ← fp2x8.Fp2x8.neg root
      let y ← fp2x8.Fp2x8.select flip root fx2
      let membership ← g2x8.G2x8.scott_membership { c0 := f, c1 := f1 } y
      let i3 ← lift (membership.undecided &&& i1)
      let i4 ← lift (decoded.undecided ||| i3)
      let i5 ← lift (membership.members &&& i1)
      let i6 ← lift (~~~ i4)
      let i7 ← lift (i5 &&& i6)
      let x0 ← fp8.Fp8.to_blst_limbs f
      let x1 ← fp8.Fp8.to_blst_limbs f1
      let y0 ← fp8.Fp8.to_blst_limbs y.c0
      let y1 ← fp8.Fp8.to_blst_limbs y.c1
      let a1 ←
        decompress_g2.decompress_loop
          { start := 0#usize, «end» := fp8.LANES } a x0 x1 y0 y1
      ok { points := a1, on_curve := i1, valid := i7, undecided := i4 }

